{
  "name": "JobPosting",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short note about this saved posting, up to 1000 characters."
    },
    "job_title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "work_address": {
      "type": "string"
    },
    "drive_distance_km": {
      "type": "number"
    },
    "drive_minutes": {
      "type": "number"
    },
    "location_checked": {
      "type": "boolean",
      "default": false
    },
    "imported_from": {
      "type": "string",
      "enum": [
        "link",
        "text",
        "search"
      ],
      "default": "text"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "tailored"
      ],
      "default": "saved"
    },
    "application_id": {
      "type": "string"
    }
  },
  "required": [
    "job_description"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}