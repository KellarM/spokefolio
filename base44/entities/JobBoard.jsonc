{
  "name": "JobBoard",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "national",
        "regional",
        "government",
        "specialty",
        "user"
      ],
      "default": "user"
    },
    "coverage": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
