{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "posting_id": {
      "type": "string"
    },
    "work_address": {
      "type": "string"
    },
    "drive_distance_km": {
      "type": "number"
    },
    "drive_minutes": {
      "type": "number"
    },
    "location_checked": {
      "type": "boolean",
      "default": false
    },
    "cover_letter": {
      "type": "string"
    },
    "match_summary": {
      "type": "string"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "selected_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "not_applied",
        "applied",
        "contacted",
        "interviewing",
        "offer",
        "declined",
        "not_hired",
        "rejected"
      ],
      "default": "ready"
    },
    "resume_template": {
      "type": "string"
    },
    "resume_layout": {
      "type": "object",
      "properties": {
        "placement": {
          "type": "string",
          "enum": [
            "style",
            "left",
            "center"
          ],
          "default": "style"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hidden_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "photo": {
          "type": "string",
          "enum": [
            "style",
            "on",
            "off"
          ],
          "default": "style"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "company_researched_at": {
      "type": "string"
    },
    "company_research": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string"
        },
        "founded": {
          "type": "string"
        },
        "years_active": {
          "type": "string"
        },
        "headquarters": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "ownership": {
          "type": "string"
        },
        "what_they_do": {
          "type": "string"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "management": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "labour_reputation": {
          "type": "string"
        },
        "employee_themes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "labour_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "recent_news": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hiring_notes": {
          "type": "string"
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "confidence": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "default": []
        }
      }
    },
    "resume": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "dates": {
                "type": "string"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "degree": {
                "type": "string"
              },
              "institution": {
                "type": "string"
              },
              "dates": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interview_prep": {
      "type": "object",
      "properties": {
        "proof_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "gap_responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gap": {
                "type": "string"
              },
              "response": {
                "type": "string"
              }
            }
          }
        },
        "likely_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions_to_ask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string"
        }
      }
    },
    "last_sent_to": {
      "type": "string"
    },
    "last_sent_at": {
      "type": "string"
    },
    "resume_pdf_uri": {
      "type": "string"
    },
    "cover_letter_pdf_uri": {
      "type": "string"
    },
    "mock_interviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "session_type": {
            "type": "string",
            "enum": [
              "practice",
              "answers"
            ],
            "default": "practice"
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "finished"
            ]
          },
          "greeting": {
            "type": "string"
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "story": {
                        "type": "string"
                      },
                      "answer": {
                        "type": "string"
                      }
                    }
                  }
                },
                "feedback": {
                  "type": "object",
                  "properties": {
                    "landed": {
                      "type": "string"
                    },
                    "improve": {
                      "type": "string"
                    },
                    "model_answer": {
                      "type": "string"
                    }
                  }
                },
                "asked_at": {
                  "type": "string"
                },
                "answered_at": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "readiness": {
                "type": "string"
              },
              "strengths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rehearse": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "best_proof_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "job_description"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}